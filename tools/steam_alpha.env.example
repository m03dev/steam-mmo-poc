# Copy to tools/steam_alpha.env (gitignored) and fill in. Sourced by tools/steampipe.sh.
#
# Your app's numeric App ID, as shown in Steamworks. This must match the contents of
# steam_appid.txt in this repo, or the upload is refused on purpose: a build that runs
# as one app cannot be shipped to another.
STEAM_APP_ID=0

# The Windows depot id from Steamworks -> SteamPipe -> Depots.
STEAM_DEPOT_ID=0

# The Steam account that owns the app and will do the uploads. Log in with
# `steamcmd +login <this>` once, interactively, before using the script.
STEAM_USER=

# Which branch the build goes live on.
STEAM_BRANCH=alpha
# Optional: the password testers type to reach that branch in the Steam client.
STEAM_BRANCH_PASSWORD=
